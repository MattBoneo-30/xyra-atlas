{
  "name": "xyra-atlas",
  "private": true,
  "version": "1.59.0",
  "type": "module",
  "description": "Xyra Atlas — an offline-first pocket library for a life of learning.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:webkit": "node tests/webkit-smoke.mjs",
    "audit:curriculum": "node scripts/audit-curriculum.mjs",
    "audit:assets": "node scripts/audit-static-assets.mjs",
    "export:editorial": "node scripts/export-editorial-review.mjs",
    "export:language-review": "node scripts/export-language-review.mjs",
    "audit:editorial": "node scripts/audit-editorial-attestations.mjs",
    "sign:editorial": "node scripts/sign-editorial-review.mjs",
    "check:sources": "node scripts/check-course-sources.mjs",
    "check": "node --check app.js && node --check paths.js && npm test && npm run build",
    "audit:devices": "node scripts/audit-device-evidence.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
